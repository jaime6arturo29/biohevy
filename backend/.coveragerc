[run]
relative_files = True
source = 
    backend
omit =
    backend/tests/*
    backend/seed.py
    backend/run_tests.py
    backend/migrate.py
    backend/diagnostico_emg.py
    backend/test_engine.py
    backend/test_integration.py
    backend/update_images.py
    backend/update_lat.py

[report]
show_missing = True
precision = 1
