          "name": "DELETE /routines/{id} — Eliminar rutina",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/routines/{{createdRoutineId}}",
              "host": ["{{baseUrl}}"],
              "path": ["routines", "{{createdRoutineId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
