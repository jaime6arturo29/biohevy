    },
    {
      "name": "4. Flujo E2E de Sesión de Entrenamiento",
      "item": [
        {
          "name": "POST /sessions/start — Iniciar sesión",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": {{userId}},\n  \"start_time\": \"2026-11-18T10:00:00Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sessions/start",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "start"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.expect(jsonData).to.have.property('id');",
                  "pm.collectionVariables.set(\"activeSessionId\", jsonData.id);",
                  "pm.test(\"Sesión creada para el usuario correcto\", function () {",
                  "    pm.expect(jsonData.user_id).to.eql(Number(pm.collectionVariables.get(\"userId\")));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /sessions/{id}/end — Finalizar sesión con cálculo de volumen",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"end_time\": \"2026-11-18T10:45:00Z\",\n  \"sets\": [\n    {\n      \"exercise_id\": 1,\n      \"reps\": 10,\n      \"weight\": 80.0,\n      \"is_failure\": false\n    },\n    {\n      \"exercise_id\": 1,\n      \"reps\": 10,\n      \"weight\": 80.0,\n      \"is_failure\": true\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sessions/{{activeSessionId}}/end",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "{{activeSessionId}}", "end"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Cálculo exacto de volumen: (10*80 + 10*80 = 1600kg)\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.volume).to.eql(1600);",
                  "});",
                  "pm.test(\"Cálculo de calorías mayor a cero\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.calories).to.be.above(0);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /sessions — Listar historial de sesiones del usuario",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions?user_id={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["sessions"],
              "query": [
                {
                  "key": "user_id",
                  "value": "{{userId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"El historial contiene la sesión recién finalizada\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "    var current = jsonData.find(s => s.id === Number(pm.collectionVariables.get(\"activeSessionId\")));",
                  "    pm.expect(current).to.not.be.undefined;",
                  "    pm.expect(current.total_volume).to.eql(1600);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Casos de Borde y Negative Testing (ISO 25010 Seguridad & Errores)",
      "item": [
        {
          "name": "GET /users/99999 — Usuario inexistente debe ser 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/99999",
              "host": ["{{baseUrl}}"],
              "path": ["users", "99999"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Responde con HTTP 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "pm.test(\"No responde con error interno 500 ni null con 200\", function () {",
                  "    pm.expect(pm.response.code).to.not.eql(500);",
                  "    pm.expect(pm.response.code).to.not.eql(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /sessions/start — Usuario inexistente debe ser 404",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 99999,\n  \"start_time\": \"2026-11-18T10:00:00Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sessions/start",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "start"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Responde con HTTP 404 Not Found para usuario inválido\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /sessions/99999/end — Sesión inexistente debe ser 404",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"end_time\": \"2026-11-18T10:45:00Z\",\n  \"sets\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sessions/99999/end",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "99999", "end"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Responde con HTTP 404 Not Found para sesión inexistente\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "DELETE /routines/99999 — Rutina inexistente debe ser 404",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/routines/99999",
              "host": ["{{baseUrl}}"],
              "path": ["routines", "99999"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Responde con HTTP 404 Not Found para rutina inexistente\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /sessions/start con Body inválido — Validación Pydantic (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"not_a_number\",\n  \"start_time\": \"invalid_date\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/sessions/start",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "start"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Responde con HTTP 422 Unprocessable Entity por tipos de datos erróneos\", function () {",
                  "    pm.response.to.have.status(422);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
