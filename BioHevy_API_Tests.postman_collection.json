          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Respuesta status success\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('success');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /stats/{id} — Estadísticas del usuario",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/stats/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["stats", "{{userId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Contiene métricas acumuladas\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('total_sessions');",
                  "    pm.expect(jsonData).to.have.property('total_volume');",
                  "    pm.expect(jsonData).to.have.property('total_calories');",
                  "    pm.expect(jsonData.total_sessions).to.be.a('number');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Gestión de Rutinas",
      "item": [
        {
          "name": "POST /routines — Crear rutina válida",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rutina Postman QA\",\n  \"user_id\": {{userId}},\n  \"exercises\": [\n    {\n      \"exercise_id\": 1,\n      \"order_index\": 1,\n      \"template_data\": \"[{\\\"reps\\\": 10, \\\"weight\\\": 80}]\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/routines",
              "host": ["{{baseUrl}}"],
              "path": ["routines"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.id) {",
                  "    pm.collectionVariables.set(\"createdRoutineId\", jsonData.id);",
                  "}",
                  "pm.test(\"Retorna ID y nombre de la rutina\", function () {",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData.name).to.eql('Rutina Postman QA');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /routines — Listar rutinas del usuario",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/routines?user_id={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["routines"],
              "query": [
                {
                  "key": "user_id",
                  "value": "{{userId}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Lista contiene la rutina creada\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "    var found = jsonData.some(r => r.name === 'Rutina Postman QA');",
                  "    pm.expect(found).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "PUT /routines/{id} — Actualizar nombre de rutina",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rutina Postman QA (Actualizada)\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/routines/{{createdRoutineId}}",
              "host": ["{{baseUrl}}"],
              "path": ["routines", "{{createdRoutineId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
