{
  "info": {
    "_postman_id": "biohevy-api-quality-collection-v1",
    "name": "BioHevy API — Suite de Pruebas de Calidad (ISO 25010)",
    "description": "Colección completa de pruebas funcionales, de integración, rendimiento y casos de borde para la API REST de BioHevy (FastAPI). Diseñada para la evaluación de la rúbrica de calidad de software.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "activeSessionId",
      "value": "",
      "type": "string"
    },
    {
      "key": "createdRoutineId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Catálogos y Ejercicios",
      "item": [
        {
          "name": "GET /exercises — Lista completa",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/exercises",
              "host": ["{{baseUrl}}"],
              "path": ["exercises"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Tiempo de respuesta < 500ms (ISO 25010 Rendimiento)\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});",
                  "pm.test(\"Respuesta es un arreglo de ejercicios\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "    pm.expect(jsonData.length).to.be.above(0);",
                  "    pm.expect(jsonData[0]).to.have.property('id');",
                  "    pm.expect(jsonData[0]).to.have.property('name');",
                  "    pm.expect(jsonData[0]).to.have.property('muscle_group');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /exercises?group_id=Pecho — Filtro por grupo muscular",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/exercises?group_id=Pecho",
              "host": ["{{baseUrl}}"],
              "path": ["exercises"],
              "query": [
                {
                  "key": "group_id",
                  "value": "Pecho"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Todos los ejercicios pertenecen a 'Pecho'\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "    jsonData.forEach(function(ex) {",
                  "        pm.expect(ex.muscle_group).to.eql('Pecho');",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
